# Copy this file to .env.local and edit. .env.local is never committed.

# Any OpenAI-compatible chat API. Default: a local Ollama server (nothing leaves your computer).
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
# Only needed for hosted APIs (e.g. OpenAI). Leave empty for Ollama.
AI_API_KEY=

# Where the Screenpipe app listens.
SCREENPIPE_URL=http://localhost:3030

# ---- Outreach (/outreach page) ----
# Demo mode: made-up leads, nothing sent. Remove to use real accounts.
# OUTREACH_MOCK=1

# Apify API token (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

# Google OAuth client (type "Desktop app"). Then run `bun run google:auth`
# and paste the refresh token it prints.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The spreadsheet ID is the long part of its URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Leads / Unprocessed

# For better drafts than a small local model, any OpenAI-compatible host works, e.g. OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<a model id from openrouter.ai/models>
# AI_API_KEY=your-openrouter-key
